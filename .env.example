# ==============================================================================
# Environment Configuration Template for Adsterra Publisher Fleet & FreeLLMAPI
# Copy this file to .env and replace with your real secrets.
# NEVER commit the real .env file to version control.
# ==============================================================================

# FreeLLMAPI Gateway Configuration
FREELLMAPI_TOKEN=your_token_here
FREELLMAPI_URL=http://localhost:3001/v1

# Cloudflare Zero Trust Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Google Search Console (GSC) API & Indexing
GSC_SERVICE_ACCOUNT_JSON=state/gsc_service_account.json
